# =============================================================================
# AI Learning Tutoring Platform — Scope A
# Copy to .env and adjust. Never commit real API keys.
# =============================================================================

# --- App ---
APP_NAME=AI Learning Tutor
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://tutor:tutor@postgres:5432/tutor
# Sync URL used by Alembic
DATABASE_URL_SYNC=postgresql://tutor:tutor@postgres:5432/tutor

# --- Redis (ARQ + SSE progress) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sources
S3_REGION=us-east-1
S3_SECURE=false

# --- Task backend: arq (compose) | inline (dev/tests without Redis) ---
TASK_BACKEND=arq

# --- Storage: minio | local ---
STORAGE_BACKEND=minio
LOCAL_STORAGE_PATH=/data/storage

# --- RAG: pgvector | llamaindex ---
RAG_PROVIDER=llamaindex
EMBEDDING_DIM=1536

# --- STT: mock (default, no GPU) | faster_whisper ---
STT_PROVIDER=mock

# --- LLM routing (China-first defaults; Mock for tests/dev) ---
# Business code only passes task="summarize"|extract_knowledge|quiz_generate|tutor|segment_summarize|embed
LLM_DEFAULT_PROVIDER=mock
PROVIDERS_CONFIG_PATH=/app/config/providers.yaml

# API keys — read from env, never stored in frontend or plaintext DB
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible override (any vendor)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Overseas egress: httpx honors these automatically. Never hardcode a proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis,minio

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
JWT_EXPIRE_MINUTES=10080
